# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.

# Supabase PostgreSQL connection string
# Find it in: Supabase dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# JWT secret — generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local only:
#   ALLOWED_ORIGINS=http://localhost:5173
# Local + Vercel production:
#   ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
